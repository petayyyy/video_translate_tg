# В образ не должно попадать ничего, кроме кода и requirements.txt.
# Особенно важно исключить data/ — там могут лежать гигабайты кэша,
# и без этого файла docker посылал бы их демону на каждой сборке.

data/
.env
config.yaml
nginx/certs/

**/__pycache__/
**/*.py[cod]
**/*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/

.git/
.gitignore
.idea/
.vscode/
*.swp

README.md
