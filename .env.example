# =============================================================================
#  video_tg — переменные окружения для docker compose
#
#  Скопируй в .env и заполни:
#      cp .env.example .env
#
#  Здесь только то, что нужно самому docker compose. Все настройки поведения
#  бота живут в config.yaml.
#
#  Файл .env содержит секреты — не клади его в git и не делай доступным всем:
#      chmod 600 .env
# =============================================================================


# --- Токен бота ---------------------------------------------------------------
# Выдаёт @BotFather командой /newbot. Подставляется в config.yaml через
# ${BOT_TOKEN}, поэтому в самом конфиге токен писать не нужно.
BOT_TOKEN=123456789:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA


# --- Доступ к Telegram API ------------------------------------------------------
# Нужны локальному серверу telegram-bot-api. Это НЕ токен бота.
#
# Где взять:
#   1. Зайди на https://my.telegram.org своим номером телефона
#   2. API development tools
#   3. Создай приложение (название и краткое имя — любые, например video_tg)
#   4. Скопируй оттуда api_id и api_hash
#
# Одна пара значений годится для любого числа ботов.
TELEGRAM_API_ID=1234567
TELEGRAM_API_HASH=0123456789abcdef0123456789abcdef


# --- Права на файлы --------------------------------------------------------------
# UID и GID, под которыми работает бот внутри контейнера. Им же принадлежит
# каталог ./data на хосте.
#
# Узнать свои:  id -u ; id -g
#
# НЕ СТАВЬ СЮДА 0. Контейнер не должен работать от root, а сборка образа
# с APP_UID=0 всё равно не пройдёт: группа с GID 0 в образе уже существует.
# Если ставишь бот от root — оставь 1000 как есть; root на хосте сохранит
# полный доступ к ./data в любом случае.
APP_UID=1000
APP_GID=1000


# --- Версии ------------------------------------------------------------------------
# Версия vot-cli, которая ставится в образ. Менять только осознанно: набор
# флагов между мажорными версиями отличается (см. README).
VOT_CLI_VERSION=2.0.1


# --- Сеть ---------------------------------------------------------------------------
# Порт, на котором nginx раздаёт большие файлы наружу. Значения по умолчанию
# нет: на сервере, где уже работает веб-сервер, VPN или прокси, привычный
# порт 80 обычно занят, поэтому выбрать нужно осознанно. Без этой переменной
# docker compose не стартует.
#
# 1. Посмотреть, что уже занято:
#        ss -tuln | grep LISTEN
# 2. Открыть выбранный порт в файрволе:
#        sudo ufw allow <ПОРТ>/tcp
# 3. Прописать тот же порт в config.yaml:
#        links:
#          public_base_url: "http://<АДРЕС_СЕРВЕРА>:<ПОРТ>"
#
# Если порт 80 свободен — можно указать 80, тогда порт в public_base_url
# писать не нужно.
HTTP_PORT=

# Порт для HTTPS. Нужен, только если раскомментируешь TLS-блок в nginx.conf
# и проброс 443 в docker-compose.yml.
# HTTPS_PORT=


# --- Прочее --------------------------------------------------------------------------
# Часовой пояс контейнеров: влияет на метки времени в логах.
TZ=Europe/Moscow
